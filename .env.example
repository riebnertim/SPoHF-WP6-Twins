# ==============================================================================
# ENVIRONMENT CONFIG (infrastructure, connections, credentials)
# ==============================================================================

# SPoHF Datalake API
WP6_API_BASE_URL=https://backoffice.spohf.com
WP6_API_TOKEN=your-bearer-token-here

# Bounds a full sync (WP6_SYNC_MODE=full). Both set = backfill just that window.
# WP6_SYNC_START=2024-11-01
# WP6_SYNC_END=2025-12-01

# BLUE TimescaleDB (local Docker default, override for production)
WP6_TSDB_URL=postgresql://wp6:wp6dev@localhost:5433/wp6_blue
# RED Dashboard (TimescaleDB for manual uploads + the letsgrow sync)
WP6_RED_TSDB_URL=postgresql://wp6_red:wp6dev@localhost:5433/wp6_red

# RED Dashboard (MySQL backend for legacy LoRaWAN sensors)
WP6_RED_DB_HOST=localhost
WP6_RED_DB_PORT=3306
WP6_RED_DB_NAME=spohf2
WP6_RED_DB_USER=your-mysql-user
WP6_RED_DB_PASSWORD=your-mysql-password


# OIDC authentication (shared by red and blue dashboards)
WP6_OIDC_ISSUER=https://auth.fontysvenlo.dev/realms/spohf
WP6_OIDC_CLIENT_ID=wp6-data
WP6_OIDC_CLIENT_SECRET=
WP6_OIDC_SESSION_SECRET=  # generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Public base URL of the app (used to build /auth/callback redirect URI)
# WP6_OIDC_REDIRECT_BASE=https://wp6-red.example.com
# Skip OIDC entirely and inject a fake dev-user (never use in production)
WP6_OIDC_DEV_AUTH=false

# ------------------------------------------------------------------------------
# Object store (S3-compatible). REQUIRED — CSV exports live here, and the
# dashboards and export job refuse to start without it. There is no on-disk
# fallback: a silent one meant the export job wrote to a directory while the
# dashboard read an empty bucket, and nothing said why.
#
# These point at the local object store from docker-compose.tsdb.yml
# (adobe/s3mock, which accepts any credentials):
#   docker compose -f docker-compose.tsdb.yml up -d
#
# Set them HERE, not as a shell export: the dashboards, the nightly export job
# and the CLI are separate processes and all read .env.
#
# Use a different bucket from the e2e suite's `wp6-e2e` — those fixtures empty
# their bucket before and after every test.
WP6_S3_BUCKET=wp6-dev
WP6_S3_ENDPOINT_URL=http://localhost:9100
WP6_S3_ACCESS_KEY_ID=wp6
WP6_S3_SECRET_ACCESS_KEY=wp6devsecret
# ------------------------------------------------------------------------------

# Manual-upload directories (admin file uploads: red Sijia .xlsx, blue insect
# .csv). Prod mounts PVCs at /data/...; these local dev dirs are gitignored.
# Files land at {dir}/{slug}/{sha256}{suffix}; only the latest 2 per source
# are kept on disk (audit rows in manual_uploads are kept forever).
WP6_RED_UPLOAD_DIR=./uploads-red
WP6_BLUE_UPLOAD_DIR=./uploads-blue

# Logging
WP6_LOG_LEVEL=INFO
# Can be "console" (human-friendly) or "json" (structured logs for production)
WP6_LOG_FORMAT=console

# ==============================================================================
# APPLICATION CONFIG (behavior, features, settings)
# ==============================================================================

# Sync behavior
WP6_SYNC_MODE=incremental  # "full" (all history from 2024-01-01) or "incremental" (recent + dupe stop)
WP6_SYNC_PAGE_SIZE=1000
WP6_SYNC_WINDOW_DAYS=1
# yookr-data syncs into blue (WP6_TSDB_URL); letsgrow-data into red
# (WP6_RED_TSDB_URL). Both may be listed: each goes to its own database.
WP6_ENDPOINTS=yookr-data
# /status data-freshness budget for synced endpoints (upstream-stall detection).
WP6_SYNC_STALE_HOURS=2     # data lag over this → "stale"
WP6_SYNC_OUTAGE_HOURS=6    # data lag over this → "likely outage"

# Display
WP6_DISPLAY_TIMEZONE=Europe/Amsterdam  # Timezone for chart axis labels and hover tooltips

# Chart page
WP6_CHART_QUERY_LIMIT=100000  # Max data points per series in /chart

# RED weather/location settings (for DLI optimization)
WP6_RED_WEATHER_LAT=51.033056        # Greenhouse latitude
WP6_RED_WEATHER_LON=6.613721         # Greenhouse longitude

# RED ML model path (optional - defaults to .models/light_model.pkl in project dir)
# WP6_RED_DLI_MODEL_PATH=/data/models/light_model.pkl

# DLI attenuation override (for testing/simulation, default is trained value
#WP6_RED_DLI_ATTENUATION_OVERRIDE=0.62
